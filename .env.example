# 可选。通常直接运行 `node bin/weibo.js login` 扫码登录即可。
# CI 或服务器环境也可以手动配置登录后的完整 Cookie。
WEIBO_COOKIE=

# 可选。快速模式默认每次 API 请求至少间隔 300ms。
WEIBO_REQUEST_DELAY_MS=300

# 可选。超过 1200 条的账号默认使用 600ms 保守间隔。
WEIBO_SAFE_DELAY_MS=600

# 可选。保守模式每 40 页主动暂停一次，降低深分页风控概率。
WEIBO_SAFE_PAUSE_EVERY=40

# 可选。保守模式每次主动暂停 20 秒。
WEIBO_SAFE_PAUSE_MS=20000
